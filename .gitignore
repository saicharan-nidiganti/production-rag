# =============================================================================
# This repository is PUBLIC. Never commit secrets or real user documents.
# =============================================================================

# --- Secrets and local configuration -----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
/secrets/

# --- Private document data (see data/README.md) ------------------------------
/data/raw/*
!/data/raw/.gitkeep
/uploads/
/storage/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/

# --- Node / frontend ---------------------------------------------------------
node_modules/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/frontend/test-results/
/frontend/playwright-report/

# --- Local databases, vector stores and model caches -------------------------
# The default SQLite database is data/rag.db; WAL mode adds -wal and -shm files.
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
/.pgdata/
/.cache/
/.models/

# --- Generated evaluation reports --------------------------------------------
# Commit a report deliberately with `git add -f` when it documents a decision.
/eval/reports/

# --- Logs --------------------------------------------------------------------
*.log
/logs/

# --- Operating systems and editors -------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
