# Copy to .env and adjust. Every setting can also be set as an environment variable,
# and an empty value means "unset". All settings: docs/configuration.md.
# Lines starting with "# RAG_" show optional settings at their defaults.

# --- Storage ---
RAG_DATABASE_URL=sqlite:///data/rag.db

# --- Ingestion ---
# RAG_MAX_UPLOAD_BYTES=26214400
# RAG_MAX_PDF_PAGES=500
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=150
# Background processing of uploads: threads per API process (0 = none in this process),
# idle poll interval, claim lease, and interrupted attempts before a document fails.
# RAG_INGEST_WORKERS=1
# RAG_INGEST_POLL_INTERVAL_S=2
# RAG_INGEST_LEASE_S=300
# RAG_INGEST_MAX_ATTEMPTS=3

# --- Embeddings ---
# "fastembed" (semantic, recommended; needs the local-embeddings extra and downloads
# ~66 MB on first use) or "hashing" (lexical-only, offline, deterministic; the default).
RAG_EMBEDDING_PROVIDER=fastembed
# RAG_EMBEDDING_DIMENSIONS=512
# RAG_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# RAG_FASTEMBED_CACHE_DIR=/var/lib/rag/models

# --- Retrieval ---
# RAG_RETRIEVAL_MODE=hybrid
# RAG_TOP_K=5
# RAG_CANDIDATE_POOL=30
# RAG_RRF_K=60
# Leave unset to use the calibrated default for the embedding provider.
# RAG_MIN_VECTOR_SCORE=0.55
# Cross-encoder reranking (recommended): better ranking and a stronger signal for
# abstaining on off-topic questions; about 30 ms per query on a laptop CPU.
RAG_RERANKER=fastembed
# RAG_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RAG_RERANK_CANDIDATES=5
# Leave unset to use the calibrated default for the reranker model.
# RAG_MIN_RERANK_SCORE=-8.4

# --- Generation ---
# "anthropic" (Claude, grounded answers with native citations) or "extractive"
# (offline baseline that quotes retrieved sentences; the default).
RAG_GENERATOR=anthropic
# Claude API key (RAG_ANTHROPIC_API_KEY also works). Leave empty to let the SDK find
# credentials itself, e.g. from the process environment or an `ant auth login` profile.
ANTHROPIC_API_KEY=
# RAG_ANTHROPIC_MODEL=claude-opus-5-5
# RAG_ANTHROPIC_EFFORT=medium
# RAG_ANTHROPIC_MAX_TOKENS=16000
# RAG_ANTHROPIC_TIMEOUT_S=120
# RAG_ANTHROPIC_MAX_RETRIES=2
# RAG_ANTHROPIC_FALLBACKS=true

# --- API ---
# When set, /v1/* requires "Authorization: Bearer <key>" or "X-API-Key: <key>".
# At least 16 characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty means authentication is off.
RAG_API_KEY=
# RAG_LOG_LEVEL=INFO
