# Copy to .env and adjust. Every setting can also be set as an environment variable.
# The full list, with defaults, is in src/production_rag/config.py.

# --- Storage ---
RAG_DATABASE_URL=sqlite:///data/rag.db

# --- Embeddings ---
# "fastembed" (semantic, recommended; needs the local-embeddings extra and downloads
# ~66 MB on first use) or "hashing" (lexical-only, offline, deterministic; the default).
RAG_EMBEDDING_PROVIDER=fastembed
RAG_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# RAG_FASTEMBED_CACHE_DIR=/var/lib/rag/models

# --- Retrieval ---
RAG_RETRIEVAL_MODE=hybrid
RAG_TOP_K=5
# Leave unset to use the calibrated default for the embedding provider.
# RAG_MIN_VECTOR_SCORE=0.55

# --- Generation ---
# "anthropic" (Claude, grounded answers with native citations) or "extractive"
# (offline baseline that quotes retrieved sentences; the default).
RAG_GENERATOR=anthropic
RAG_ANTHROPIC_MODEL=claude-opus-5-5
RAG_ANTHROPIC_EFFORT=medium
# Claude API key (RAG_ANTHROPIC_API_KEY also works). Leave empty to let the SDK find
# credentials itself, e.g. from the process environment or an `ant auth login` profile.
ANTHROPIC_API_KEY=

# --- API ---
# When set, /v1/* requires "Authorization: Bearer <key>" or "X-API-Key: <key>".
# At least 16 characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty means authentication is off.
RAG_API_KEY=
RAG_LOG_LEVEL=INFO
